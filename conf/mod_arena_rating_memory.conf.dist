[worldserver]

########################################
# mod-arena-rating-memory configuration
########################################
#
#    The rating a player receives when joining a team is:
#
#        PR = max(remembered rating, the rating the core would give a first time joiner)
#
#    so a returning member never ends up below someone joining that team for the first time. The
#    second term comes from the core itself, including whatever Arena.ArenaStartPersonalRating in
#    worldserver.conf is set to, so there is nothing to keep in sync here.
#
#    ArenaRatingMemory.Enable
#        Description: Remember each player's personal rating per arena team, and restore it when
#                     they rejoin a team they were in before.
#        Default:     1 - Enabled
#                     0 - Disabled
#

ArenaRatingMemory.Enable = 1

#
#    ArenaRatingMemory.Announce
#        Description: Announce to the player on login that this module is enabled.
#        Default:     0 - Disabled
#                     1 - Enabled
#

ArenaRatingMemory.Announce = 0
